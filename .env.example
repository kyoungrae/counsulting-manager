# Generate a different value for each secret: openssl rand -hex 32
# Mongo passwords must be URL-safe because Compose constructs the internal URI.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGODB_DB=consulting_manager
SESSION_SECRET=

# Local Docker access. For public use set the exact HTTPS origin + secure cookie.
APP_ORIGIN=http://localhost:3080
ALLOWED_ORIGINS=
COOKIE_SECURE=false
# Existing HTTPS proxy/tunnel or compose.edge.yaml: set TRUST_PROXY=1.
TRUST_PROXY=loopback
# Optional request diagnostics; credentials and bodies are never logged.
LOG_REQUESTS=false

# Hosting frontend: use your MacBook's public HTTPS API URL, including /api.
# Same-origin app and Vite development use /api.
VITE_API_BASE_URL=/api

# Only for compose.edge.yaml, e.g. analysis.example.com (no scheme or path).
APP_DOMAIN=

# Only for a host-run Node API. Docker overrides this with its internal URI.
# Replace YOUR_HEX_APP_PASSWORD with MONGO_APP_PASSWORD, then use compose.dev.yaml.
MONGODB_URI=mongodb://consulting_app:YOUR_HEX_APP_PASSWORD@127.0.0.1:27029/consulting_manager?authSource=consulting_manager
HOST=127.0.0.1
PORT=3080
